# ==============================================================================
# DocuMindAI - Root Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' at the project root:
#      cp .env.example .env
# 2. Fill in your actual credentials below.
# 3. Never commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL / Neon Database Configuration
# External Neon Database credentials used by Spring Data JPA & pgvector.
# (Docker Compose will NOT start a local database container)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-hostname>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# ------------------------------------------------------------------------------
# Google Gemini API & Model Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# Frontend & Port Mapping Configuration
# ------------------------------------------------------------------------------
# Host port on which the frontend will be accessible (default: 3000)
FRONTEND_PORT=3000

# Optional API base URL override for Vite build.
# Leave blank (default) to route /api requests through the built-in Nginx reverse proxy.
VITE_API_BASE_URL=
